<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_tender_process_form" model="ir.ui.view">
        <field name="name">tender.process.form</field>
        <field name="model">tender.process</field>
        <field name="arch" type="xml">
            <form string="Tender Process">
                <header>
                    <button name="action_send_invitations" 
                            type="object" 
                            string="Send Invitations"
                            class="btn-primary"
                            states="draft"/>
                    <button name="action_start_bid_collection" 
                            type="object" 
                            string="Start Bid Collection"
                            states="invitation_sent"/>
                    <button name="action_evaluate_bids" 
                            type="object" 
                            string="Evaluate Bids"
                            states="bid_collection"/>
                    <button name="action_award_tender" 
                            type="object" 
                            string="Award Tender"
                            class="btn-primary"
                            states="evaluation"/>
                    <button name="action_cancel_tender" 
                            type="object" 
                            string="Cancel"
                            states="draft,invitation_sent,bid_collection,evaluation"/>
                    <field name="state" widget="statusbar"/>
                </header>
                
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="purchase_order_id"/>
                            <field name="estimated_amount"/>
                            <field name="bid_submission_deadline"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                            <field name="winning_bid_id" states="awarded"/>
                        </group>
                    </group>
                    
                    <field name="description"/>
                    
                    <notebook>
                        <page string="Invited Vendors">
                            <field name="vendor_ids"/>
                        </page>
                        <page string="Bids">
                            <field name="bid_ids">
                                <tree editable="bottom">
                                    <field name="vendor_id"/>
                                    <field name="bid_amount"/>
                                    <field name="technical_score"/>
                                    <field name="price_score"/>
                                    <field name="total_score"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    
    <!-- Tree View -->
    <record id="view_tender_process_tree" model="ir.ui.view">
        <field name="name">tender.process.tree</field>
        <field name="model">tender.process</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="purchase_order_id"/>
                <field name="estimated_amount"/>
                <field name="state"/>
                <field name="bid_submission_deadline"/>
            </tree>
        </field>
    </record>
    
    <!-- Action -->
    <record id="action_tender_process" model="ir.actions.act_window">
        <field name="name">Tender Processes</field>
        <field name="res_model">tender.process</field>
        <field name="view_mode">tree,form</field>
    </record>
    
    <!-- Menu -->
    <menuitem id="menu_tender_process"
              name="Tender Management"
              parent="purchase.menu_purchase_root"
              sequence="20"/>
              
    <menuitem id="menu_tender_process_all"
              name="All Tenders"
              parent="menu_tender_process"
              action="action_tender_process"
              sequence="10"/>
</odoo>