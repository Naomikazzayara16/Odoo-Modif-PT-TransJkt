<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_tender_process_form" model="ir.ui.view">
        <field name="name">tender.process.form</field>
        <field name="model">tender.process</field>
        <field name="arch" type="xml">
            <form string="Tender Process">
                <header>
                    <button name="action_send_invitations" 
                            type="object" 
                            string="Send Invitations"
                            class="btn-primary"
                            modifier="draft"
                            confirm="Are you sure you want to send tender invitations to selected vendors?"/>
                    <button name="action_start_bid_collection" 
                            type="object" 
                            string="Start Bid Collection"
                            modifier="invitation_sent"
                            confirm="Start bid collection period?"/>
                    <button name="action_evaluate_bids" 
                            type="object" 
                            string="Evaluate Bids"
                            modifier="bid_collection"
                            confirm="Start bid evaluation process?"/>
                    <button name="action_award_tender" 
                            type="object" 
                            string="Award Tender"
                            class="btn-primary"
                            modifier="evaluation"
                            confirm="Are you sure you want to award this tender to the selected bidder?"/>
                    <button name="action_cancel_tender" 
                            type="object" 
                            string="Cancel"
                            modifier="draft,invitation_sent,bid_collection,evaluation"
                            confirm="Are you sure you want to cancel this tender process?"/>
                    <button name="action_reset_to_draft" 
                            type="object" 
                            string="Reset to Draft"
                            modifier="cancelled"
                            confirm="Reset this tender back to draft status?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,invitation_sent,bid_collection,evaluation,awarded"/>
                </header>
                
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_bids" type="object" class="oe_stat_button" icon="fa-list-alt">
                            <field name="bid_count" widget="statinfo" string="Total Bids"/>
                        </button>
                        <button name="action_view_bids" type="object" class="oe_stat_button" icon="fa-check-circle" 
                                domain="[('state', '=', 'submitted')]">
                            <field name="submitted_bid_count" widget="statinfo" string="Submitted"/>
                        </button>
                    </div>
                    
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Basic Information">
                            <field name="purchase_order_id" readonly="1"/>
                            <field name="estimated_amount" widget="monetary"/>
                            <field name="bid_submission_deadline" modifier="{'readonly': [('state', 'not in', ['draft', 'invitation_sent'])]}"/>
                            <field name="state_display" invisible="1"/>
                        </group>
                        <group string="Award Information">
                            <field name="company_id" readonly="1"/>
                            <field name="winning_bid_id" 
                                   modifier="{'invisible': [('state', 'not in', ['evaluation', 'awarded'])],
                                          'required': [('state', '=', 'evaluation')],
                                          'readonly': [('state', '=', 'awarded')]}"
                                   domain="[('tender_id', '=', id), ('state', '=', 'submitted')]"/>
                        </group>
                    </group>
                    
                    <group string="Description">
                        <field name="description" nolabel="1" modifier="{'readonly': [('state', 'not in', ['draft'])]}"/>
                    </group>
                    
                    <notebook>
                        <page string="Invited Vendors" modifier="{'invisible': [('state', 'in', ['awarded', 'cancelled'])]}">
                            <field name="vendor_ids" 
                                   modifier="{'readonly': [('state', 'not in', ['draft'])]}"
                                   context="{'default_is_company': True, 'default_supplier_rank': 1}">
                                <tree>
                                    <field name="name"/>
                                    <field name="email"/>
                                    <field name="phone"/>
                                    <field name="city"/>
                                    <field name="supplier_rank"/>
                                </tree>
                            </field>
                        </page>
                        
                        <page string="Vendor Bids">
                            <field name="bid_ids" readonly="1">
                                <tree string="All Bids"
                                    decoration-success="state == 'won'" 
                                    decoration-danger="state == 'lost'" 
                                    decoration-info="state == 'submitted'"
                                    decoration-muted="state == 'invited'">
                                        <field name="vendor_id"/>
                                        <field name="bid_amount" widget="monetary" sum="Total Bid Amount"/>
                                        <field name="submission_date"/>
                                        <field name="technical_score"/>
                                        <field name="price_score"/>
                                        <field name="total_score"/>
                                        <field name="state"/>
                                        <field name="is_winning_bid" invisible="1"/>
                                </tree>
                             
                                <form string="Vendor Bid">
                                    <header>
                                        <field name="state" widget="statusbar"/>
                                    </header>
                                    <sheet>
                                        <div class="oe_title">
                                            <h1>
                                                <field name="display_name" readonly="1"/>
                                            </h1>
                                        </div>
                                        <group>
                                            <group>
                                                <field name="vendor_id" readonly="1"/>
                                                <field name="bid_amount" widget="monetary"/>
                                                <field name="submission_date" readonly="1"/>
                                            </group>
                                            <group>
                                                <field name="technical_score"/>
                                                <field name="price_score"/>
                                                <field name="total_score" readonly="1"/>
                                                <field name="is_winning_bid" readonly="1"/>
                                            </group>
                                        </group>
                                        <group string="Notes">
                                            <field name="notes" nolabel="1"/>
                                        </group>
                                        <group string="Attachments">
                                            <field name="attachment_ids" nolabel="1" widget="many2many_binary"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field> 
                        </page>
                        
                        <page string="Evaluation Summary" modifier="{'invisible': [('state', 'in', ['draft', 'invitation_sent'])]}">
                            <group>
                                <group string="Bid Statistics">
                                    <field name="bid_count" readonly="1"/>
                                    <field name="submitted_bid_count" readonly="1"/>
                                </group>
                                <group string="Winner Information" modifier="{'invisible': [('winning_bid_id', '=', False)]}">
                                    <field name="winning_bid_id" readonly="1"/>
                                </group>
                            </group>
                            
                            <!-- Summary of all submitted bids sorted by total score -->
                            <separator string="Bid Ranking (by Total Score)"/>
                            <field name="bid_ids" readonly="1" 
                                   domain="[('state', '=', 'submitted')]">
                                <tree create="false" delete="false" edit="false" default_order="total_score desc">
                                    <field name="vendor_id"/>
                                    <field name="bid_amount" widget="monetary"/>
                                    <field name="technical_score"/>
                                    <field name="price_score"/>
                                    <field name="total_score" decoration-bf="1"/>
                                    <field name="state" invisible="1"/>
                                </tree>
                            </field> 
                            <field name="bid_ids" readonly="1"
                                    domain="[('state', '=', 'submitted')]">
                                <tree string="Submitted Bids"
                                    create="false" delete="false" edit="false"
                                    default_order="total_score desc">
          
                                    <field name="vendor_id"/>
                                    <field name="bid_amount" widget="monetary"/>
                                    <field name="technical_score"/>
                                    <field name="price_score"/>
                                    <field name="total_score"/>
                                    <field name="state" invisible="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    
    <!-- Tree View -->
    <record id="view_tender_process_tree" model="ir.ui.view">
        <field name="name">tender.process.tree</field>
        <field name="model">tender.process</field>
        <field name="type">tree</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'awarded'" 
                  decoration-danger="state == 'cancelled'" 
                  decoration-info="state == 'evaluation' or state == 'bid_collection'" 

                  decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="display_name"/>
                <field name="purchase_order_id"/>
                <field name="estimated_amount" widget="monetary" sum="Total Estimated Amount"/>
                <field name="bid_submission_deadline"/>
                <field name="bid_count"/>
                <field name="submitted_bid_count"/>
                <field name="state" 
                       decoration-success="state == 'awarded'" 
                       decoration-danger="state == 'cancelled'" 
                       decoration-info="state == 'evaluation' or state == 'bid_collection'" 

                       decoration-muted="state == 'draft'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>
    
    <!-- Search View -->
    <record id="view_tender_process_search" model="ir.ui.view">
        <field name="name">tender.process.search</field>
        <field name="model">tender.process</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Tender Reference"/>
                <field name="purchase_order_id" string="Purchase Order"/>
                <field name="vendor_ids" string="Vendors"/>
                <field name="winning_bid_id" string="Winner"/>
                
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Invitation Sent" name="invitation_sent" domain="[('state', '=', 'invitation_sent')]"/>
                <filter string="Collecting Bids" name="bid_collection" domain="[('state', '=', 'bid_collection')]"/>
                <filter string="Under Evaluation" name="evaluation" domain="[('state', '=', 'evaluation')]"/>
                <filter string="Awarded" name="awarded" domain="[('state', '=', 'awarded')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                
                <separator/>
                <filter string="Active Tenders" name="active" 
                        domain="[('state', 'in', ['draft', 'invitation_sent', 'bid_collection', 'evaluation'])]"/>
                <filter string="High Value" name="high_value" 
                        domain="[('estimated_amount', '>=', 500000000)]"/>
                <filter string="Deadline This Week" name="deadline_week" 
                        domain="[('bid_submission_deadline', '&gt;=', context_today().strftime('%Y-%m-%d')),
                                ('bid_submission_deadline', '&lt;=', (context_today() + datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                    <filter string="Submission Month" name="group_month" context="{'group_by': 'bid_submission_deadline:month'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Kanban View -->
    <record id="view_tender_process_kanban" model="ir.ui.view">
        <field name="name">tender.process.kanban</field>
        <field name="model">tender.process</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="display_name"/>
                <field name="purchase_order_id"/>
                <field name="estimated_amount"/>
                <field name="bid_submission_deadline"/>
                <field name="bid_count"/>
                <field name="submitted_bid_count"/>
                <field name="state"/>
                <field name="winning_bid_id"/>
                
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_content">
                                <div class="o_kanban_record_title">
                                    <field name="display_name"/>
                                </div>
                                <div class="o_kanban_record_subtitle">
                                    <field name="purchase_order_id"/>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div>
                                        <strong>Estimated: </strong>
                                        <field name="estimated_amount" widget="monetary"/>
                                    </div>
                                    <div>
                                        <strong>Deadline: </strong>
                                        <field name="bid_submission_deadline" widget="date"/>
                                    </div>
                                    <div t-if="record.bid_count.raw_value">
                                        <strong>Bids: </strong>
                                        <t t-esc="record.submitted_bid_count.value"/> / <t t-esc="record.bid_count.value"/>
                                    </div>
                                    <div t-if="record.winning_bid_id.raw_value and record.state.raw_value == 'awarded'">
                                        <strong>Winner: </strong>
                                        <field name="winning_bid_id"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- Calendar View -->
    <record id="view_tender_process_calendar" model="ir.ui.view">
        <field name="name">tender.process.calendar</field>
        <field name="model">tender.process</field>
        <field name="arch" type="xml">
            <calendar string="Tender Deadlines" 
                      date_start="bid_submission_deadline" 
                      color="state" 
                      event_open_popup="true">
                <field name="display_name"/>
                <field name="estimated_amount"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>
    
    <!-- Action -->
    <record id="action_tender_process" model="ir.actions.act_window">
        <field name="name">Tender Processes</field>
        <field name="res_model">tender.process</field>
        <field name="view_mode">kanban,tree,form,calendar</field>
        <field name="search_view_id" ref="view_tender_process_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first tender process!
            </p>
            <p>
                Tender processes are automatically created when purchase orders exceed the company's tender threshold.
                You can also create them manually for strategic procurement activities.
            </p>
        </field>
    </record>
    
    <!-- Action for Active Tenders -->
    <record id="action_tender_process_active" model="ir.actions.act_window">
        <field name="name">Active Tenders</field>
        <field name="res_model">tender.process</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('state', 'in', ['draft', 'invitation_sent', 'bid_collection', 'evaluation'])]</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>
    
    <!-- Action for Awarded Tenders -->
    <record id="action_tender_process_awarded" model="ir.actions.act_window">
        <field name="name">Awarded Tenders</field>
        <field name="res_model">tender.process</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('state', '=', 'awarded')]</field>
    </record>
    
    <!-- Menu Structure -->
    <menuitem id="menu_tender_process"
              name="Tender Management"
              parent="purchase.menu_purchase_root"
              sequence="20"/>
              
    <menuitem id="menu_tender_process_all"
              name="All Tenders"
              parent="menu_tender_process"
              action="action_tender_process"
              sequence="10"/>
              
    <menuitem id="menu_tender_process_active"
              name="Active Tenders"
              parent="menu_tender_process"
              action="action_tender_process_active"
              sequence="20"/>
              
    <menuitem id="menu_tender_process_awarded"
              name="Awarded Tenders"
              parent="menu_tender_process"
              action="action_tender_process_awarded"
              sequence="30"/>
</odoo>