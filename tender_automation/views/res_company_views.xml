<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Company Form View - Add tender threshold setting -->
    <record id="view_company_form_tender" model="ir.ui.view">
        <field name="name">res.company.form.tender</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <!-- Add tender threshold after company_details -->
            <xpath expr="//form//group" position="inside">
                <group string="Tender Management" name="tender_management">
                    <field name="tender_threshold" widget="monetary" 
                           help="Minimum purchase order amount that requires tender process"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>